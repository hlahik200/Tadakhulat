rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // القراءة متاحة لصفحات المنصة
    match /{col}/{id} {
      allow read: if col in ['config', 'schools', 'subs'];
      // الكتابة لمجموعات المنصة الثلاث فقط، وبحجم معقول، حتى نهاية فترة التجربة
      allow write: if col in ['config', 'schools', 'subs']
                   && request.time < timestamp.date(2027, 6, 30);
    }
  }
}
